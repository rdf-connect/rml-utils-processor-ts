@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <https://w3id.org/conn#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.
@prefix dc: <http://purl.org/dc/terms/>.

rdfc:Yarrrml2RML a owl:Class, rdfs:Class;
  dc:title "yarrrml processor";
  dc:description "The YARRRML processor transforms YARRRML documents into RML mapping documents.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/yarrrml/yarrrml.js>;
  rdfc:class "Yarrrml2RML";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfc:Yarrrml2RML;
  sh:property [
    sh:class rdfc:Reader;
    sh:path rdfc:input;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "reader";
  ], [
    sh:class rdfc:Writer;
    sh:path rdfc:output;
    sh:maxCount 1;
    sh:minCount 1;
    sh:name "writer";
  ].

rdfc:RMLMapperJS a owl:Class, rdfs:Class;
  dc:title "RMLMapperJS processor";
  dc:description "The RMLMapperJS processor wraps the Java RMLMapper to produce RDF data based on RML mappings.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/rml/rml.js>;
  rdfc:class "RMLMapperJS";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfc:RmlSource;
  sh:property [
    sh:path rdfc:sourceLocation;
    sh:datatype xsd:string;
    sh:name "location";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:input;
    sh:class rdfc:Reader;
    sh:name "dataInput";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:trigger;
    sh:datatype xsd:boolean;
    sh:name "trigger";
    sh:maxCount 1;
  ], [
    sh:path rdfc:incRMLStateIndex;
    sh:datatype xsd:string;
    sh:name "incRMLStateIndex";
    sh:minCount 0;
    sh:maxCount 1;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:RmlTarget;
  sh:property [
    sh:path rdfc:targetLocation;
    sh:datatype xsd:string;
    sh:name "location";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfc:output;
    sh:class rdfc:Writer;
    sh:name "writer";
    sh:maxCount 1;
    sh:minCount 1;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:RMLMapperJS;
  sh:property [
    sh:path rdfc:mappings;
    sh:name "mappingInput";
    sh:class rdfc:Reader;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:output;
    sh:name "defaultWriter";
    sh:class rdfc:Writer;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:rmlSource;
    sh:name "sources";
    sh:class rdfc:RmlSource;
    sh:minCount 0;
  ], [
    sh:path rdfc:rmlTarget;
    sh:name "targets";
    sh:class rdfc:RmlTarget;
    sh:minCount 0;
  ], [
    sh:path rdfc:rmlJar;
    sh:name "jarLocation";
    sh:datatype xsd:string;
    sh:minCount 0;
    sh:maxCount 1;
  ].

rdfc:IncRMLTransformer a rdfc:Processor;
  dc:title "Incremental RML processor";
  dc:description "The Incremental RML processor transforms a stream of RML mapping documents into corresponding Incremental RML documents.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/rml/incrml.js>;
  rdfc:class "RML2IncRML";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfc:IncRMLTransformer;
  sh:property [
    sh:path rdfc:rmlStream;
    sh:name "rmlStream";
    sh:class rdfc:Reader;
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:config;
    sh:name "config";
    sh:class rdfc:IncRMLConfig;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfc:incrmlStream;
    sh:name "incrmlStream";
    sh:class rdfc:Writer;
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:IncRMLConfig;
  sh:property [
    sh:path rdfc:stateBasePath;
    sh:datatype xsd:string;
    sh:name "stateBasePath";
    sh:maxCount 1;
    sh:minCount 1
  ], [
    sh:path rdfc:lifeCycleConfig;
    sh:class rdfc:LifeCycleConfig;
    sh:name "lifeCycleConfig";
    sh:maxCount 1;
    sh:minCount 1
  ], [
    sh:path rdfc:targetConfig;
    sh:class rdfc:LDESTargetConfig;
    sh:name "targetConfig";
    sh:minCount 0;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:LifeCycleConfig;
  sh:property [
    sh:path rdfc:predicate;
    sh:datatype xsd:string;
    sh:name "predicate";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:create;
    sh:class rdfc:EventConfig;
    sh:name "create";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:update;
    sh:class rdfc:EventConfig;
    sh:name "update";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:delete;
    sh:class rdfc:EventConfig;
    sh:name "delete";
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:EventConfig;
  sh:property [
    sh:path rdfc:function;
    sh:datatype xsd:string;
    sh:name "function";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:type;
    sh:datatype xsd:string;
    sh:name "type";
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfc:LDESTargetConfig;
  sh:property [
    sh:path rdfc:targetPath;
    sh:datatype xsd:string;
    sh:name "targetPath";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:timestampPath;
    sh:datatype xsd:string;
    sh:name "timestampPath";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:versionOfPath;
    sh:datatype xsd:string;
    sh:name "versionOfPath";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:serialization;
    sh:datatype xsd:string;
    sh:name "serialization";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:uniqueIRIs;
    sh:name "uniqueIRIs";
    sh:datatype xsd:boolean;
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfc:ldesBaseIRI;
    sh:datatype xsd:string;
    sh:name "ldesBaseIRI";
    sh:minCount 0;
    sh:maxCount 1
  ], [
    sh:path rdfc:shape;
    sh:datatype xsd:string;
    sh:name "shape";
    sh:minCount 0;
    sh:maxCount 1
  ].