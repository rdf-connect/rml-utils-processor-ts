@prefix rdfc: <https://w3id.org/rdf-connect#>.
@prefix rdfcp: <https://w3id.org/rdf-connect/processors#>.
@prefix owl: <http://www.w3.org/2002/07/owl#>.
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#>.
@prefix xsd: <http://www.w3.org/2001/XMLSchema#>.
@prefix : <https://w3id.org/conn#>.
@prefix sh: <http://www.w3.org/ns/shacl#>.

rdfcp:Yarrrml2RML a owl:Class, rdfs:Class;
  rdfs:label "YARRRML to RML Transformer";
  rdfs:comment "Transforms YARRRML mapping documents into RML mapping documents.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/yarrrml/yarrrml.js>;
  rdfc:class "Yarrrml2RML";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:Yarrrml2RML;
  sh:property [
    sh:class rdfc:Reader;
    sh:path rdfcp:input;
    sh:maxCount 1;
    sh:minCount 1;
    sh:codeIdentifier "reader";
    sh:name "Input channel";
    sh:description "Input channel that streams YARRRML mapping documents as strings.";
  ], [
    sh:class rdfc:Writer;
    sh:path rdfcp:output;
    sh:maxCount 1;
    sh:minCount 1;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel that receives the generated RML mapping documents.";
  ].

rdfcp:RMLMapperJS a owl:Class, rdfs:Class;
  rdfs:label "RML Mapper Processor";
  rdfs:comment "Executes RML mapping documents with the Java RMLMapper, and streams the produced RDF to RDF-Connect channels.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/rml/rml.js>;
  rdfc:class "RMLMapperJS";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:RmlSource;
  sh:property [
    sh:path rdfcp:sourceLocation;
    sh:datatype xsd:string;
    sh:codeIdentifier "location";
    sh:name "Source location";
    sh:description "Source location as referenced by rml:source in the mapping documents.";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:input;
    sh:class rdfc:Reader;
    sh:codeIdentifier "dataInput";
    sh:name "Input channel";
    sh:description "Input channel that provides the source data.";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:trigger;
    sh:datatype xsd:boolean;
    sh:codeIdentifier "trigger";
    sh:name "Trigger";
    sh:description "Whether new data on this source triggers another execution of the mappings; default is false.";
    sh:defaultValue false;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:incRMLStateIndex;
    sh:datatype xsd:string;
    sh:codeIdentifier "incRMLStateIndex";
    sh:name "IncRML state index";
    sh:description "Regular expression matched against incoming data, whose first capture group is appended to the IncRML state paths, so independent datasets on the same logical source keep separate state.";
    sh:minCount 0;
    sh:maxCount 1;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:RmlTarget;
  sh:property [
    sh:path rdfcp:targetLocation;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "location";
    sh:name "Target location";
    sh:description "Target location as referenced by void:dataDump in the mapping documents. It is compared as is, so an IRI must be absolute.";
    sh:maxCount 1;
    sh:minCount 1;
  ], [
    sh:path rdfcp:output;
    sh:class rdfc:Writer;
    sh:codeIdentifier "writer";
    sh:name "Output channel";
    sh:description "Output channel that receives the RDF written to this logical target.";
    sh:maxCount 1;
    sh:minCount 1;
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:RMLMapperJS;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "mappingInput";
    sh:name "Input channel";
    sh:description "Input channel that streams RML mapping documents.";
    sh:class rdfc:Reader;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "defaultWriter";
    sh:name "Output channel";
    sh:description "Default output channel for the RDF produced by mappings without an explicit logical target.";
    sh:class rdfc:Writer;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:rmlSource;
    sh:codeIdentifier "sources";
    sh:name "Logical sources";
    sh:description "Logical sources managed by RDF-Connect, written to temporary files and matched against rml:source in the mapping documents.";
    sh:class rdfcp:RmlSource;
    sh:minCount 0;
  ], [
    sh:path rdfcp:rmlTarget;
    sh:codeIdentifier "targets";
    sh:name "Logical targets";
    sh:description "Logical targets managed by RDF-Connect, matched against void:dataDump in the logical targets of the mapping documents.";
    sh:class rdfcp:RmlTarget;
    sh:minCount 0;
  ], [
    sh:path rdfcp:rmlJar;
    sh:codeIdentifier "jarLocation";
    sh:name "RMLMapper jar";
    sh:description "Path or URL of an RMLMapper jar; if omitted, the default RMLMapper release is downloaded to /tmp and reused.";
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:minCount 0;
    sh:maxCount 1;
  ].

rdfcp:IncRMLTransformer a owl:Class, rdfs:Class;
  rdfs:label "Incremental RML Transformer";
  rdfs:comment "Transforms a stream of RML mapping documents into Incremental RML (IncRML) mapping documents.";
  rdfc:jsImplementationOf rdfc:Processor;
  rdfc:file <./lib/rml/incrml.js>;
  rdfc:class "RML2IncRML";
  rdfc:entrypoint <./>.

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:IncRMLTransformer;
  sh:property [
    sh:path rdfcp:input;
    sh:codeIdentifier "rmlStream";
    sh:name "Input channel";
    sh:description "Input channel that streams RML mapping documents.";
    sh:class rdfc:Reader;
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:config;
    sh:codeIdentifier "config";
    sh:name "Configuration";
    sh:description "IncRML transformation configuration.";
    sh:class rdfcp:IncRMLConfig;
    sh:minCount 1;
    sh:maxCount 1;
  ], [
    sh:path rdfcp:output;
    sh:codeIdentifier "incrmlStream";
    sh:name "Output channel";
    sh:description "Output channel that receives the IncRML mapping documents.";
    sh:class rdfc:Writer;
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:IncRMLConfig;
  sh:property [
    sh:path rdfcp:stateBasePath;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "stateBasePath";
    sh:name "State base path";
    sh:description "Base path of the generated IncRML state files.";
    sh:maxCount 1;
    sh:minCount 1
  ], [
    sh:path rdfcp:lifeCycleConfig;
    sh:class rdfcp:LifeCycleConfig;
    sh:codeIdentifier "lifeCycleConfig";
    sh:name "Life cycle configuration";
    sh:description "Life cycle predicate, and the function and RDF type of the create, update and delete events.";
    sh:maxCount 1;
    sh:minCount 1
  ], [
    sh:path rdfcp:targetConfig;
    sh:class rdfcp:LDESTargetConfig;
    sh:codeIdentifier "targetConfig";
    sh:name "LDES target configuration";
    sh:description "LDES logical target to generate, with LDES metadata and unique immutable IRIs.";
    sh:minCount 0;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:LifeCycleConfig;
  sh:property [
    sh:path rdfcp:predicate;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "predicate";
    sh:name "Life cycle predicate";
    sh:description "Predicate that describes the life cycle event type.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:create;
    sh:class rdfcp:EventConfig;
    sh:codeIdentifier "create";
    sh:name "Create event";
    sh:description "Function and RDF type of create events.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:update;
    sh:class rdfcp:EventConfig;
    sh:codeIdentifier "update";
    sh:name "Update event";
    sh:description "Function and RDF type of update events.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:delete;
    sh:class rdfcp:EventConfig;
    sh:codeIdentifier "delete";
    sh:name "Delete event";
    sh:description "Function and RDF type of delete events.";
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:EventConfig;
  sh:property [
    sh:path rdfcp:function;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "function";
    sh:name "Function";
    sh:description "IRI of the FnO function used for the event.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:type;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "type";
    sh:name "Event type";
    sh:description "IRI of the RDF type emitted for the event.";
    sh:minCount 1;
    sh:maxCount 1
  ].

[ ] a sh:NodeShape;
  sh:targetClass rdfcp:LDESTargetConfig;
  sh:property [
    sh:path rdfcp:targetPath;
    sh:datatype xsd:string;
    sh:codeIdentifier "targetPath";
    sh:name "Target path";
    sh:description "Output path of the generated logical target.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:timestampPath;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "timestampPath";
    sh:name "Timestamp path";
    sh:description "LDES timestamp path.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:versionOfPath;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "versionOfPath";
    sh:name "Version-of path";
    sh:description "LDES version-of path.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:serialization;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "serialization";
    sh:name "Serialization";
    sh:description "IRI of the RML target serialization, such as formats:N-Triples.";
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:uniqueIRIs;
    sh:codeIdentifier "uniqueIRIs";
    sh:name "Unique IRIs";
    sh:description "Whether the generated LDES members get unique immutable IRIs.";
    sh:datatype xsd:boolean;
    sh:minCount 1;
    sh:maxCount 1
  ], [
    sh:path rdfcp:ldesBaseIRI;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "ldesBaseIRI";
    sh:name "LDES base IRI";
    sh:description "Base IRI of the generated LDES.";
    sh:minCount 0;
    sh:maxCount 1
  ], [
    sh:path rdfcp:shape;
    sh:nodeKind sh:IRIOrLiteral;
    sh:codeType xsd:string;
    sh:codeIdentifier "shape";
    sh:name "Shape";
    sh:description "IRI of the TREE shape of the generated LDES.";
    sh:minCount 0;
    sh:maxCount 1
  ].